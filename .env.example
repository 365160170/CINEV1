# Copia este archivo como .env.local y llena los valores.
# Sin estos valores la app arranca en modo demostracion (datos solo en el navegador).

# Firebase (Configuracion del proyecto -> Tus apps -> Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=

# ID del espacio privado creado en el paso 3 del README
VITE_SPACE_ID=nuestro-cine

# TMDB: usa el token v4 O la URL de tu proxy, no ambos
VITE_TMDB_TOKEN=
VITE_TMDB_PROXY_URL=
